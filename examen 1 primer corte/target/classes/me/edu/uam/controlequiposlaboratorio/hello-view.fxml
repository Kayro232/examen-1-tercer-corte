<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="me.edu.uam.controlequiposlaboratorio.controller.EquipoController"
            prefWidth="1100" prefHeight="660"
            style="-fx-background-color: #eef2ff; -fx-font-family: 'Segoe UI', Arial, sans-serif;">

    <top>
        <VBox spacing="12" style="-fx-padding: 15 20 10 20;">
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: linear-gradient(to right, #312e81, #4f46e5); -fx-padding: 14 22; -fx-background-radius: 10;">
                <Label text="SISTEMA DE INVENTARIO TECNOLÓGICO"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 19px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Gestión de Laboratorio ORM"
                       style="-fx-text-fill: #c7d2fe; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <VBox spacing="12"
                  style="-fx-background-color: #ffffff; -fx-padding: 16 20; -fx-background-radius: 10; -fx-border-color: #c7d2fe; -fx-border-radius: 10; -fx-border-width: 1;">
                <Label text="Registro y Edición de Equipos"
                       style="-fx-text-fill: #312e81; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                <GridPane hgap="14" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="22"/>
                        <ColumnConstraints percentWidth="28"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="ID Interno" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtId" editable="false" disable="true" promptText="Autogenerado"
                                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 6;"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Código del Equipo *" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtCodigo" promptText="Ej. EQ-009"
                                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Nombre / Modelo *" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtNombre" promptText="Nombre descriptivo"
                                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="Marca" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtMarca" promptText="Fabricante"
                                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Cantidad Disponible *" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtCantidad" promptText="0 o mayor"
                                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Categoría / Tipo *" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccionar categoría"
                                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="Estado Operativo *" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccionar estado"
                                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                    </VBox>

                    <VBox spacing="4" alignment="BOTTOM_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <Button text="Limpiar Campos / Recargar" onAction="#onLimpiar" maxWidth="Infinity"
                                style="-fx-background-color: #e0e7ff; -fx-text-fill: #3730a3; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 7 12;"/>
                    </VBox>
                </GridPane>

                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
                    <Button text="Registrar Nuevo" onAction="#onGuardar" prefWidth="150"
                            style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16;"/>
                    <Button text="Guardar Cambios" onAction="#onActualizar" prefWidth="150"
                            style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16;"/>
                    <Button text="Dar de Baja" onAction="#onEliminar" prefWidth="140"
                            style="-fx-background-color: #e11d48; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16;"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 0 20 18 20;">
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: #ffffff; -fx-padding: 12 18; -fx-background-radius: 10; -fx-border-color: #c7d2fe; -fx-border-radius: 10; -fx-border-width: 1;">
                <Label text="Filtro de Búsqueda:" style="-fx-text-fill: #312e81; -fx-font-weight: bold;"/>
                <TextField fx:id="txtBuscarNombre" promptText="Escribir nombre del equipo..." HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                <Label text="Categoría:" style="-fx-text-fill: #312e81; -fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbFiltroTipo" promptText="Todas las categorías" prefWidth="200"
                          style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                <Button text="Filtrar Inventario" onAction="#onBuscar" minWidth="-Infinity"
                        style="-fx-background-color: #312e81; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 7 18;"/>
            </HBox>

            <TableView fx:id="tablaEquipos" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 10; -fx-border-color: #c7d2fe; -fx-border-radius: 10;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCodigo" text="CÓDIGO" prefWidth="90"/>
                    <TableColumn fx:id="colNombre" text="NOMBRE DEL EQUIPO" prefWidth="210"/>
                    <TableColumn fx:id="colMarca" text="MARCA" prefWidth="110"/>
                    <TableColumn fx:id="colTipo" text="CATEGORÍA" prefWidth="140"/>
                    <TableColumn fx:id="colEstado" text="ESTADO ACTUAL" prefWidth="140"/>
                    <TableColumn fx:id="colCantidad" text="UNIDADES" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
